{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ascend Advanced Therapies Content API (WordPress REST) Careers Media API",
    "version": "wp/v2"
  },
  "items": [
    {
      "info": {
        "name": "Media",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List media attachments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.ascend-adv.com/wp-json/wp/v2/media",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Current page of the collection."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return per page."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Limit results to those matching a string."
              },
              {
                "name": "media_type",
                "value": "",
                "type": "query",
                "description": "Limit results to a media type."
              }
            ]
          },
          "docs": "List media attachments"
        },
        {
          "info": {
            "name": "Get a media attachment by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.ascend-adv.com/wp-json/wp/v2/media/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the resource."
              }
            ]
          },
          "docs": "Get a media attachment by ID"
        }
      ]
    }
  ],
  "bundled": true
}